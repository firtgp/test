# Frontend (публичные значения, попадают в сборку). Без них сайт работает в демо-режиме.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Только для воркера мониторинга (worker/monitor.ts) на сервере. Никогда не добавляйте во frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
MONITOR_INTERVAL_MS=60000
MONITOR_TIMEOUT_MS=5000

# Секреты Edge Function launcher-auth задаются командой `supabase secrets set`, не в этом файле:
#   GAME_SERVER_KEY — общий ключ игровых серверов: маршрут has-joined и очередь выдачи покупок (функция shop)
#   PAYMENT_WEBHOOK_SECRET — секрет подписи webhook платёжного провайдера (функция shop, маршрут payment)
